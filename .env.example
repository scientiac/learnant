SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Railway provides DATABASE_URL for its PostgreSQL service.
# DATABASE_URL=postgresql://user:password@host:port/database
# For production set DEBUG=false, a generated SECRET_KEY, your ALLOWED_HOSTS,
# and HTTPS CSRF_TRUSTED_ORIGINS. Railway should supply DATABASE_URL.
# MEDIA_ROOT=/data/uploads  # Mount a persistent Railway volume at /data for uploads.

# PostgreSQL target configuration. If POSTGRES_DB is unset, local development uses SQLite.
# POSTGRES_DB=tenant_learning
# POSTGRES_USER=tenant_learning
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Deployment bootstrap: set securely in your host's secret manager, then run the
# one-time `python manage.py bootstrap_superadmin` command after migrations.
# Never commit real credentials.
# LEARNANT_SUPERADMIN_USERNAME=platform_owner
# LEARNANT_SUPERADMIN_EMAIL=owner@example.org
# LEARNANT_SUPERADMIN_PASSWORD=
